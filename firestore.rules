rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidLead(data) {
      return data.keys().hasAny(['userId', 'fullName', 'mobile', 'status', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid;
    }

    function isValidDocument(data) {
      return data.keys().hasAll(['userId', 'leadId', 'name', 'url', 'createdAt'])
        && data.userId == request.auth.uid
        && data.createdAt is number;
    }
    
    match /followUps/{followUpId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
        
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /callLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
    
    match /leads/{leadId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
        
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
      
      match /documents/{documentId} {
        allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
        
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
          
        allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && existing().userId == request.auth.uid;
      }
    }
  }
}
